# === NUTRIPLAN SUPPORT CHAT API CONFIGURATION ===
# Copy this file to .env and replace every REPLACE_WITH_... value. Never commit .env.
# These are read on the server only (api/ and lib/). They are never sent to the browser.

# Google Gemini: AI-generated chat responses (https://aistudio.google.com/apikey)
GEMINI_API_KEY=REPLACE_WITH_YOUR_GEMINI_API_KEY
# Optional: model id. Change it if your key can't use the default.
# GEMINI_MODEL=gemini-3.8-flash
# Optional: if replies are slow because the model "thinks" first, try a lower level (minimal, low, medium, high). Only set it if your model supports it.
# GEMINI_THINKING_LEVEL=low

# ElevenLabs: text-to-speech for chat responses (https://elevenlabs.io/app/settings/api-keys)
ELEVENLABS_API_KEY=REPLACE_WITH_YOUR_ELEVENLABS_API_KEY
# ElevenLabs voice configuration: a voice id that your account can use (Voice Library -> copy voice id)
ELEVENLABS_VOICE_ID=REPLACE_WITH_YOUR_ELEVENLABS_VOICE_ID
# Optional: model id
# ELEVENLABS_MODEL_ID=eleven_v4

# Photon (Spectrum): OPTIONAL iMessage agent, a separate process (npm run photon).
# Photon does not use a single API key. It uses a project id + secret from your Photon dashboard.
# The website chat does not use these. Leave them out if you are not running the iMessage agent.
SPECTRUM_PROJECT_ID=REPLACE_WITH_YOUR_PHOTON_PROJECT_ID
SPECTRUM_PROJECT_SECRET=REPLACE_WITH_YOUR_PHOTON_PROJECT_SECRET

# Optional server settings
# PORT=3000
# API_TIMEOUT_MS=15000   (per attempt)
# API_BUDGET_MS=24000    (total including retries; keep under Vercel's 30s limit)

# Daily menu refresh (Nutrislice -> cloud database)
# Upstash Redis REST credentials. Adding the Upstash Redis integration in Vercel (Storage / Marketplace) sets these for you
# (it may name them KV_REST_API_URL and KV_REST_API_TOKEN, which are also accepted).
UPSTASH_REDIS_REST_URL=REPLACE_WITH_YOUR_UPSTASH_REDIS_REST_URL
UPSTASH_REDIS_REST_TOKEN=REPLACE_WITH_YOUR_UPSTASH_REDIS_REST_TOKEN
# Any long random string. Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>" to /api/refresh.
CRON_SECRET=REPLACE_WITH_A_LONG_RANDOM_STRING
